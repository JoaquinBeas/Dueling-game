*.pdb
*.dll
*.lib
*.a
*.exp
*.ilk
*.exe
*.app
*.dylib
*.so
*.ipa
*.apk
*.target
*.modules

# Contenido cocinado / empaquetado
*.pak
*.ucas
*.utoc
Cooked/
Packaged/
StagedBuilds/

# Archivos de autoguardado y caché
*.tmp
*.log
*.uasset.bak
*.umap.bak

